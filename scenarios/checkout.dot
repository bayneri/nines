// Retries re-roll transient failures of payments, but an outage of the
// ledger lasts across every attempt.
digraph checkout {
    graph [entry=checkout, label="Retries don't save you"];

    checkout -> payments [retries=3, timeout_ms=800];
    payments -> ledger_db [timeout_ms=200];

    checkout [icon=web, label="Checkout"];
    payments [label="Payments"];
    ledger_db [icon=database, label="Ledger"];
}
